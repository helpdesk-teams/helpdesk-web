# Copy this file to .env.local and adjust values. Never commit real secrets.

# Base URL for REST requests. "/api" goes through the Vite dev proxy
# (vite.config.ts → http://localhost:3000), so the browser sees no CORS issues.
VITE_API_URL=/api

# Origin for the socket.io connection (path is always /ws).
# Empty value = same origin as the page, also served through the Vite proxy.
VITE_WS_URL=

# true  → API is mocked in the browser by MSW (no backend needed)
# false → requests go to the real api-gateway
VITE_USE_MOCKS=true
